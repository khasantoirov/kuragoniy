DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DEV_SUPERUSER_EMAILS=khasantoirov@gmail.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Leave unset for local dev without Redis (falls back to an in-process
# in-memory Channels layer — fine for solo `runserver` testing, but the
# Telegram bot process needs this set to a real Redis instance to receive
# cross-process broadcasts).
REDIS_URL=redis://127.0.0.1:6379/0

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Telegram bot (manage.py runbot) — requires REDIS_URL above to be a real
# Redis instance, since the bot runs as a separate OS process from the
# Django ASGI server and needs the shared channel layer to receive
# cross-process broadcasts (announcements, translation jobs).
BOT_TOKEN=
# Comma-separated numeric Telegram user ids allowed to run /backup, /backup_status
ADMIN_TELEGRAM_IDS=
# Optional — lesson translation (title/goal/experiments -> ru/en) is
# silently disabled if unset.
GOOGLE_TRANSLATE_API_KEY=

# ── Xavfsizlik / kengaytirish ──
# Telegramga yuboriladigan baza zaxirasini shifrlash kaliti. Yaratish:
#   ./venv/bin/python manage.py backup_db --generate-key
# Kalitni serverdan TASHQARIDA ham saqlang (parol menejeri) — usiz
# shifrlangan zaxirani tiklab bo'lmaydi (manage.py decrypt_backup).
BACKUP_ENCRYPTION_KEY=
# Telegram bot foydalanuvchi nomi (@ belgisiz) — hisobni ulash havolasi uchun.
TELEGRAM_BOT_USERNAME=amaliyfizikabot
FRONTEND_URL=https://amaliyfizika.uz
# Django admin panel manzili (taxmin qilib bo'lmaydigan qiling), masalan: boshqaruv-7f3k/
DJANGO_ADMIN_URL=admin/
# Bir hisobga ketma-ket noto'g'ri urinishlar soni va bloklash muddati (daqiqa).
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=15
# Foydalanuvchilar ko'payganda PostgreSQL'ga o'tish uchun (bo'sh = SQLite):
# DATABASE_URL=postgres://amaliy:parol@127.0.0.1:5432/amaliyfizika
