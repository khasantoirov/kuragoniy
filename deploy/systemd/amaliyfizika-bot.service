[Unit]
Description=Amaliy Fizika — Telegram bot
After=network.target redis-server.service amaliyfizika-backend.service
Wants=redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/amaliy-fizika/backend
EnvironmentFile=/opt/amaliy-fizika/backend/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
ExecStart=/opt/amaliy-fizika/backend/venv/bin/python manage.py runbot
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
