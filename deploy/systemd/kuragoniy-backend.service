[Unit]
Description=KO'RAGONIY EDU — Django ASGI backend (daphne)
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/kuragoniy/backend
EnvironmentFile=/opt/kuragoniy/backend/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
ExecStartPre=/opt/kuragoniy/backend/venv/bin/python manage.py migrate --noinput
ExecStartPre=/opt/kuragoniy/backend/venv/bin/python manage.py collectstatic --noinput
ExecStart=/opt/kuragoniy/backend/venv/bin/daphne -b 127.0.0.1 -p 8000 config.asgi:application
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
