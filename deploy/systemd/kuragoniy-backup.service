[Unit]
Description=KO'RAGONIY EDU — daily SQLite backup

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/opt/kuragoniy/backend
EnvironmentFile=/opt/kuragoniy/backend/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
ExecStart=/opt/kuragoniy/backend/venv/bin/python manage.py backup_db
