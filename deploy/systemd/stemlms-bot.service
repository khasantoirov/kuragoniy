[Unit]
Description=KO'RAGONIY EDU — Telegram bot (kuragoniybot)
After=network.target redis-server.service stemlms-backend.service
Wants=redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/stem-lms/backend
EnvironmentFile=/opt/stem-lms/backend/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
ExecStart=/opt/stem-lms/backend/venv/bin/python manage.py runbot
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
